{
  "name": "FMDBMigrationManager",
  "version": "3.0.0",
  "summary": "Versioned SQLite database migrations using FMDB.",
  "description": "Discovers and applies SQL or Objective-C migrations to an FMDB database.",
  "homepage": "https://github.com/lyeah-ios/FMDBMigrationManager",
  "license": {
    "type": "MIT and Apache-2.0",
    "file": "LICENSE"
  },
  "authors": {
    "Blake Watters": "blakewatters@gmail.com",
    "zisu": "zisulwl@163.com"
  },
  "source": {
    "git": "https://github.com/lyeah-ios/FMDBMigrationManager.git",
    "tag": "3.0.0"
  },
  "platforms": {
    "ios": "15.0",
    "osx": "12.0"
  },
  "requires_arc": true,
  "source_files": "FMDBMigrationManager/Core/**/*.{h,m}",
  "public_header_files": "FMDBMigrationManager/Core/**/*.h",
  "preserve_paths": "LICENSE-APACHE",
  "default_subspecs": "System",
  "subspecs": [
    {
      "name": "System",
      "dependencies": {
        "FMDB/standard": [
          ">= 2.7.12"
        ]
      }
    },
    {
      "name": "Standalone",
      "dependencies": {
        "FMDB/standalone": [
          ">= 2.7.12"
        ]
      }
    }
  ]
}
